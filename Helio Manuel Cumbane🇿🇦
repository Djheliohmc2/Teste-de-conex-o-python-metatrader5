import MetaTrader5 as mt5
import pandas as pd
import numpy as np
import time

# Inicialização do MetaTrader 5
if not mt5.initialize():
    print("initialize() falhou, error code =", mt5.last_error())
    quit()

# Configurações
symbol = "XAUUSD"
timeframe = mt5.TIMEFRAME_M15
lot = 0.01
magic_number = 123456

# Funções de Indicadores Técnicos
def get_data(symbol, timeframe, n=500):
    rates = mt5.copy_rates_from_pos(symbol, timeframe, 0, n)
    df = pd.DataFrame(rates)
    df['time'] = pd.to_datetime(df['time'], unit='s')
    df.set_index('time', inplace=True)
    return df

def calculate_ma(data, period):
    return data['close'].rolling(window=period).mean()

def calculate_rsi(data, period=14):
    delta = data['close'].diff()
    up, down = delta.copy(), delta.copy()
    up[up < 0] = 0
    down[down > 0] = 0
    roll_up1 = up.ewm(span=period).mean()
    roll_down1 = np.abs(down.ewm(span=period).mean())
    RS = roll_up1 / roll_down1
    RSI = 100.0 - (100.0 / (1.0 + RS))
    return RSI

def calculate_atr(data, period=14):
    high_low = data['high'] - data['low']
    high_close = np.abs(data['high'] - data['close'].shift())
    low_close = np.abs(data['low'] - data['close'].shift())
    ranges = pd.concat([high_low, high_close, low_close], axis=1)
    true_range = ranges.max(axis=1)
    atr = true_range.rolling(period).mean()
    return atr

# Funções de Negociação
def place_order(symbol, order_type, lot, sl, tp, magic_number):
    price = mt5.symbol_info_tick(symbol).ask if order_type == mt5.ORDER_TYPE_BUY else mt5.symbol_info_tick(symbol).bid
    request = {
        "action": mt5.TRADE_ACTION_DEAL,
        "symbol": symbol,
        "volume": lot,
        "type": order_type,
        "price": price,
        "sl": sl,
        "tp": tp,
        "magic": magic_number,
        "comment": "Python Algo",
        "type_time": mt5.ORDER_TYPE_TIME_GTC,
        "type_filling": mt5.ORDER_FILLING_RETURN,
    }
    result = mt5.order_send(request)
    if result.retcode != mt5.TRADE_RETCODE_DONE:
        print("Falha ao enviar ordem, retcode={}".format(result.retcode))
        return False
    else:
        print("Ordem enviada com sucesso")
        return True

# Estratégia Principal
def trading_strategy(data):
    # Calcular Indicadores
    data['MA_Fast'] = calculate_ma(data, period=20)
    data['MA_Slow'] = calculate_ma(data, period=50)
    data['RSI'] = calculate_rsi(data)
    data['ATR'] = calculate_atr(data)

    # Condições de Compra
    if (data['MA_Fast'].iloc[-1] > data['MA_Slow'].iloc[-1] and
        data['RSI'].iloc[-1] < 30):
        atr_value = data['ATR'].iloc[-1]
        stop_loss = mt5.symbol_info_tick(symbol).ask - (2 * atr_value)
        take_profit = mt5.symbol_info_tick(symbol).ask + (3 * atr_value)
        if place_order(symbol, mt5.ORDER_TYPE_BUY, lot, stop_loss, take_profit, magic_number):
            print("Ordem de compra colocada")

    # Condições de Venda
    elif (data['MA_Fast'].iloc[-1] < data['MA_Slow'].iloc[-1] and
          data['RSI'].iloc[-1] > 70):
        atr_value = data['ATR'].iloc[-1]
        stop_loss = mt5.symbol_info_tick(symbol).bid + (2 * atr_value)
        take_profit = mt5.symbol_info_tick(symbol).bid - (3 * atr_value)
        if place_order(symbol, mt5.ORDER_TYPE_SELL, lot, stop_loss, take_profit, magic_number):
            print("Ordem de venda colocada")

# Loop Principal
while True:
    data = get_data(symbol, timeframe)
    trading_strategy(data)
    time.sleep(60)

# Desligar o MetaTrader 5
mt5.shutdown()
